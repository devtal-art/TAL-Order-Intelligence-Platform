# Port the API server listens on (Render injects PORT automatically).
PORT=4000
NODE_ENV=development

# MongoDB connection string + database name (MongoDB Atlas in production).
MONGODB_URI=mongodb://127.0.0.1:27017/order_intelligence
MONGODB_DB=order_intelligence

# Deployed frontend origin, added to the CORS allowlist (e.g. the Vercel URL).
# localhost:5173 is always allowed for development.
# CLIENT_URL=https://your-app.vercel.app

# Optional shared API key. When set, every /api request must carry a matching
# "X-API-Key" header (set VITE_API_KEY to the same value on the frontend).
# When unset, the API is open — leave unset only on private networks.
# API_KEY=

# Optional comma-separated DNS servers for Node's resolver. Set this when the
# network's DNS refuses the SRV lookups a mongodb+srv:// URI requires (common
# on mobile hotspots and VPNs → "querySrv ECONNREFUSED"). Leave unset to use
# the system DNS.
# DNS_SERVERS=8.8.8.8,1.1.1.1

# Initial passwords used by `node scripts/seedUsers.js` — one per internal
# user. A user with no password set here is skipped by the seed script.
# Set real values in .env only; never commit them.
# SEED_PASSWORD_JASMEET=
# SEED_PASSWORD_SAHIL=
# SEED_PASSWORD_SHUBHAM=
# SEED_PASSWORD_ALPA=
# SEED_PASSWORD_SEHBAZ=
# SEED_PASSWORD_CHAT_TEAM=
# SEED_PASSWORD_GAGANDEEP=
# SEED_PASSWORD_DEV_TEAM=

# Help button (in-app "contact the team" email), sent via Brevo's
# transactional email API. BREVO_SENDER_EMAIL must already be verified as a
# sender in the Brevo account, or every send fails.
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=
# HELP_RECIPIENT_EMAIL=dev.talhouse@gmail.com
